rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 角色判定 ----------
    // 角色存在 users/{uid}.role：
    //   system_admin  系統管理員（可管理帳號與所有設定）
    //   property_admin 後台管理員（可進後台，但不能改帳號權限）
    //   resident      一般住戶（只能預約，進不了後台）
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return hasProfile() ? userDoc().role : 'none';
    }
    function isActive() {
      return hasProfile() && userDoc().disabled != true;
    }
    function isStaff() {
      return isActive() && role() in ['system_admin', 'property_admin'];
    }
    function isSystemAdmin() {
      return isActive() && role() == 'system_admin';
    }

    // ---------- 使用者帳號 ----------
    match /users/{uid} {
      // 自己看得到自己的資料（前台需要讀門牌與角色）；後台人員看得到全部
      allow get: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();

      // 建立帳號：本人首次建檔（角色強制為 resident，避免自行提權），或系統管理員代建
      allow create: if isSystemAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.role == 'resident'
                        && request.resource.data.disabled == false);

      // 本人只能改自己的姓名與電話，不能碰 role / disabled / houseNumber
      allow update: if isSystemAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['name', 'phone', 'updatedAt']));
      allow delete: if isSystemAdmin();
    }

    // ---------- 社區公告 ----------
    match /announcements/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---------- 場地 ----------
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isStaff();

      match /timeSlotTemplates/{slotId} {
        allow read: if true;
        allow write: if isStaff();
      }
      match /equipment/{equipmentId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    // ---------- 時段鎖 ----------
    // doc id = facilityId__date__slotId，靠「同一 id 只能存在一份」防止重複預約
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if isActive()
                    && lockId == request.resource.data.facilityId + '__' + request.resource.data.date + '__' + request.resource.data.slotId
                    && request.resource.data.status in ['confirmed', 'pending_review']
                    && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid;
      allow update: if isStaff()
                    // 已取消的鎖可被別人重新佔用
                    || (isActive() && resource.data.status == 'cancelled'
                        && request.resource.data.status in ['confirmed', 'pending_review'])
                    // 對應的預約已取消／拒絕時，可把鎖釋出（不影響他人的有效預約）
                    || (isActive() && request.resource.data.status == 'cancelled'
                        && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status
                           in ['cancelled', 'rejected']);
      allow delete: if isStaff();
    }

    // ---------- 同時段跨場地佔位 ----------
    // doc id = uid__date__startTime，實作「同一時段每戶限預約一項設施」
    match /unitSlotHolds/{id} {
      allow get: if isActive();
      allow list: if isStaff();
      allow create: if isActive()
                    && id == request.auth.uid + '__' + request.resource.data.date + '__' + request.resource.data.startTime
                    && request.resource.data.uid == request.auth.uid
                    && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isStaff()
                    || (isActive()
                        && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status
                           in ['cancelled', 'rejected']);
    }

    // ---------- 預約次數計數器 ----------
    // doc id 以 uid 為主鍵，住戶登入後才寫得動，
    // 且只允許 ±1、不得為負，無法自行歸零繞過上限。
    match /unitDailyUsage/{id} {
      allow read: if isActive() && (isStaff() || id.matches('^.+__' + request.auth.uid + '__.+$'));
      allow create: if isActive() && id.matches('^.+__' + request.auth.uid + '__.+$')
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if isStaff()
                    || (isActive() && id.matches('^.+__' + request.auth.uid + '__.+$')
                        && request.resource.data.keys().hasOnly(['count'])
                        && (request.resource.data.count == resource.data.count + 1
                            || request.resource.data.count == resource.data.count - 1)
                        && request.resource.data.count >= 0);
      allow delete: if isStaff();
    }
    match /unitWeeklyUsage/{id} {
      allow read: if isActive() && (isStaff() || id.matches('^.+__' + request.auth.uid + '__.+$'));
      allow create: if isActive() && id.matches('^.+__' + request.auth.uid + '__.+$')
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if isStaff()
                    || (isActive() && id.matches('^.+__' + request.auth.uid + '__.+$')
                        && request.resource.data.keys().hasOnly(['count'])
                        && (request.resource.data.count == resource.data.count + 1
                            || request.resource.data.count == resource.data.count - 1)
                        && request.resource.data.count >= 0);
      allow delete: if isStaff();
    }

    // ---------- 預約 ----------
    match /bookings/{bookingId} {
      // 只看得到自己的預約；後台人員看得到全部
      allow get: if isStaff() || (isActive() && resource.data.uid == request.auth.uid);
      allow list: if isStaff() || (isActive() && resource.data.uid == request.auth.uid);

      // 預約必須掛在自己的帳號下，無法冒用他人身分建立，姓名與房號需與個人檔相符
      allow create: if isActive()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.applicantName == userDoc().name
                    && request.resource.data.houseNumber == userDoc().houseNumber
                    && request.resource.data.keys().hasAll(
                         ['uid', 'facilityId', 'date', 'slotId', 'startTime', 'endTime',
                          'applicantName', 'houseNumber', 'status', 'createdAt'])
                    && request.resource.data.status in ['confirmed', 'pending_review'];

      // 住戶只能取消自己的預約（且僅能改 status/cancelledAt）
      allow update: if isStaff()
                    || (isActive() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'cancelledAt'])
                        && request.resource.data.status == 'cancelled');
      allow delete: if isStaff();
    }

    // ---------- 操作紀錄 ----------
    // 只有後台人員讀得到（含 IP 與載具，屬個資）；寫入後不可篡改
    match /bookingLogs/{logId} {
      allow read: if isStaff();
      allow create: if isActive();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
